<%- include('components/header', { title: 'Lịch Sử Năng Lực & Dự Án - TTT Technology' }) %>

<!-- NHÚNG FILE CSS RIÊNG -->
<link rel="stylesheet" href="/css/project.css">

<!-- MAIN CONTENT - LỊCH SỬ NĂNG LỰC / DỰ ÁN TIÊU BIỂU -->
<main class="main-wrapper-project">
