                    <div class="project-content-box">
                        <div>
                            <span class="project-category">Hạ Tầng Môi Trường</span>
                            <h3 class="project-title">Thi Công Bãi Chôn Lấp Rác Đập Đá</h3>
                            <p class="project-summary">Xây dựng và hoàn thiện hạ tầng bãi xử lý rác thải vệ sinh.</p>
                        </div>
                        <div class="project-footer-info">
                            <span class="project-location"><i class="fa-solid fa-location-dot"></i> Đồng Tháp</span>
                            <strong class="project-client">Môi trường</strong>
                        </div>
                    </div>
                </div>

                <!-- Dự án 8: KCN TASA Phú Thọ -->
