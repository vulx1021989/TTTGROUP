<%- include('components/header', { title: 'Lịch Sử Năng Lực & Dự Án - TTT Technology' }) %>

<!-- NHÚNG FILE CSS RIÊNG -->
<link rel="stylesheet" href="/css/project.css">

<!-- MAIN CONTENT - LỊCH SỬ NĂNG LỰC / DỰ ÁN TIÊU BIỂU -->
<main class="main-wrapper-project">
    <div class="container-project">
        
        <!-- HEADER SECTION -->
        <div class="project-header">
            <span class="project-tag">Hồ Sơ Năng Lực Tổng Thầu</span>
            <h1 class="project-main-title">Lịch Sử Năng Lực & Các Dự Án Tiêu Biểu</h1>
            <p class="project-desc">
                TTT Technology tự hào là tổng thầu uy tín, cung cấp các giải pháp toàn diện về hạ tầng kỹ thuật, xử lý nước thải và vận hành bảo trì đạt chuẩn ISO 9001:2015 cho các doanh nghiệp, khu công nghiệp trên toàn quốc.
            </p>
        </div>

        <!-- PROJECTS GRID SECTION -->
        <div class="projects-grid-wrapper">
            <div class="projects-grid">
                
                <!-- Dự án 1: Găng Việt -->
                <div class="project-card">
                    <div class="project-image-box bg-gang-viet">
                        <span class="project-badge-tag">3.000 m³/ngày</span>
                    </div>
                    <div class="project-content-box">
                        <div>
                            <span class="project-category">Vận Hành & Bảo Trì O&M</span>
                            <h3 class="project-title">HTXL Nước Thải Sản Xuất Găng Tay Cao Su</h3>
                            <p class="project-summary">Quản lý vận hành trọn gói hệ thống xử lý nước thải công nghiệp.</p>
                        </div>
                        <div class="project-footer-info">
                            <span class="project-location"><i class="fa-solid fa-location-dot"></i> Bình Dương</span>
                            <strong class="project-client">Cơ số: Găng Việt</strong>
                        </div>
                    </div>
                </div>

                <!-- Dự án 2: Giấy Nam Tiến -->
                <div class="project-card">
                    <div class="project-image-box bg-giay-nam-tien">
                        <span class="project-badge-tag">1.600 m³/ngày</span>
                    </div>
