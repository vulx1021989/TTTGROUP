                    <div class="project-content-box">
                        <div>
                            <span class="project-category">Thi Công Đường Giao Thông</span>
                        </div>
                        <div class="project-footer-info">
                            <span class="project-location"><i class="fa-solid fa-location-dot"></i> Khu Đô Thị</span>
