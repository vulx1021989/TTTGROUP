                </div>

                <!-- Dự án 4: Greenfeed -->
                <div class="project-card">
                    <div class="project-image-box bg-greenfeed">
                        <span class="project-badge-tag">600 m³/ngày</span>
                    </div>
                    <div class="project-content-box">
                        <div>
