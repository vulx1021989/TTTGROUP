<%- include('components/header', { title: 'Cơ Hội Nghề Nghiệp - TTT Group' }) %>

<main class="main-wrapper" style="background-color: #f8fafc; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">

    <!-- 1. HERO BANNER TUYỂN DỤNG -->
    <section style="position: relative; overflow: hidden; background: linear-gradient(rgba(18, 38, 78, 0.75), rgba(27, 94, 32, 0.75)), url('/images/banner-co-hoi-nghe-nghiep-TTT-Group.png') center/cover no-repeat; color: #fff; padding: 90px 20px; text-align: center;">
        <div style="max-width: 800px; margin: 0 auto;">
            <span style="background: rgba(16, 185, 129, 0.2); color: #34d399; padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Careers at TTT Group</span>
            <h1 style="font-size: 38px; font-weight: 800; margin: 20px 0 15px 0; line-height: 1.2;">Cơ Hội Nghề Nghiệp Tại TTT Group</h1>
            <p style="font-size: 16px; color: #94a3b8; line-height: 1.6; margin: 0;">
                Đồng hành cùng TTT Group để xây dựng sự nghiệp vững chắc trong lĩnh vực hạ tầng, môi trường và công nghệ xanh. Chúng tôi luôn chào đón các nhân tài nhiệt huyết!
            </p>
        </div>
    </section>

    <!-- 2. VĂN HÓA & MÔI TRƯỜNG LÀM VIỆC -->
    <section style="padding: 60px 5%; background-color: #fff;">
        <div style="max-width: 1150px; margin: 0 auto;">
            <div style="text-align: center; margin-bottom: 45px;">
                <h2 style="color: #0f172a; font-size: 28px; font-weight: 800; margin-bottom: 10px;">Tại sao bạn nên gia nhập TTT Group?</h2>
                <p style="color: #64748b; font-size: 15px;">Môi trường làm việc chuyên nghiệp, sáng tạo và nhiều cơ hội phát triển bản thân.</p>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 25px;">
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 30px 25px; text-align: center;">
                    <div style="width: 55px; height: 55px; background: #ecfdf5; color: #059669; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; font-size: 22px;">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <h3 style="font-size: 17px; font-weight: 700; color: #1e293b; margin-bottom: 10px;">Lộ Trình Thăng Tiến Rõ Ràng</h3>
                    <p style="font-size: 13px; color: #64748b; line-height: 1.6; margin: 0;">Đánh giá năng lực công bằng, cơ hội thăng tiến rộng mở theo quy mô phát triển không ngừng của tập đoàn.</p>
                </div>

                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 30px 25px; text-align: center;">
                    <div style="width: 55px; height: 55px; background: #e0f2fe; color: #0284c7; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; font-size: 22px;">
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                    </div>
                    <h3 style="font-size: 17px; font-weight: 700; color: #1e293b; margin-bottom: 10px;">Thu Nhập & Phúc Lợi Cạnh Tranh</h3>
                    <p style="font-size: 13px; color: #64748b; line-height: 1.6; margin: 0;">Lương thưởng hấp dẫn, chế độ bảo hiểm đầy đủ, thưởng hiệu quả công việc và các phúc lợi định kỳ.</p>
                </div>

                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 30px 25px; text-align: center;">
                    <div style="width: 55px; height: 55px; background: #fef3c7; color: #d97706; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; font-size: 22px;">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <h3 style="font-size: 17px; font-weight: 700; color: #1e293b; margin-bottom: 10px;">Đào Tạo & Phát Triển Kỹ Năng</h3>
                    <p style="font-size: 13px; color: #64748b; line-height: 1.6; margin: 0;">Thường xuyên tham gia các khóa đào tạo chuyên sâu về kỹ thuật hạ tầng, công nghệ môi trường và kỹ năng quản lý.</p>
                </div>

                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 30px 25px; text-align: center;">
                    <div style="width: 55px; height: 55px; background: #f3e8ff; color: #9333ea; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; font-size: 22px;">
                        <i class="fa-solid fa-people-group"></i>
                    </div>
                    <h3 style="font-size: 17px; font-weight: 700; color: #1e293b; margin-bottom: 10px;">Môi Trường Năng Động</h3>
                    <p style="font-size: 13px; color: #64748b; line-height: 1.6; margin: 0;">Đội ngũ nhân sự trẻ trung, chuyên nghiệp, gắn kết và luôn sẵn sàng hỗ trợ đồng nghiệp trong mọi dự án.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. DANH SÁCH VỊ TRÍ TUYỂN DỤNG ĐỘNG TỪ DATABASE -->
    <section style="padding: 60px 5%; background-color: #f8fafc;">
        <div style="max-width: 1150px; margin: 0 auto;">
            <div style="text-align: center; margin-bottom: 45px;">
                <h2 style="color: #0f172a; font-size: 30px; font-weight: 800; margin-bottom: 10px;">Vị Trí Đang Tuyển Dụng</h2>
                <p style="color: #64748b; font-size: 15px;">Hãy chọn vị trí phù hợp với năng lực và gửi hồ sơ ứng tuyển ngay hôm nay.</p>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 25px;">
                <% if (typeof jobs !== 'undefined' && jobs.length > 0) { %>
                    <% jobs.forEach(job => { %>
                        <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 30px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);">
                            <div>
                                <h3 style="font-size: 19px; font-weight: 700; color: #0f172a; margin-bottom: 12px;"><%= job.title %></h3>
                                <div style="display: flex; gap: 15px; font-size: 13px; color: #64748b; margin-bottom: 15px;">
                                    <span><i class="fa-solid fa-location-dot" style="color: #059669; margin-right: 5px;"></i> <%= job.location || 'TP. Hồ Chí Minh' %></span>
                                    <span><i class="fa-solid fa-briefcase" style="color: #0284c7; margin-right: 5px;"></i> <%= job.type || 'Toàn thời gian' %></span>
                                </div>
                                <p style="font-size: 14px; color: #475569; line-height: 1.6; margin-bottom: 25px;">
                                    <%= job.description %>
                                </p>
                            </div>
                            <a href="#sec-ung-tuyen" style="display: block; text-align: center; background-color: #0284c7; color: #fff; padding: 12px; border-radius: 8px; font-weight: 700; font-size: 14px; text-decoration: none;">Ứng Tuyển Ngay</a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <!-- Fallback hiển thị tin mẫu nếu chưa có dữ liệu DB -->
                    <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 30px;">
                        <h3 style="font-size: 19px; font-weight: 700; color: #0f172a; margin-bottom: 12px;">Kỹ Sư Vận Hành Xử Lý Nước Thải</h3>
                        <p style="font-size: 14px; color: #475569; line-height: 1.6;">Trực tiếp vận hành, giám sát các hệ thống xử lý nước thải công nghiệp và sinh hoạt...</p>
                        <a href="#sec-ung-tuyen" style="display: block; text-align: center; background-color: #0284c7; color: #fff; padding: 12px; border-radius: 8px; font-weight: 700; margin-top: 15px; text-decoration: none;">Ứng Tuyển Ngay</a>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- 4. FORM ỨNG TUYỂN NHANH (Sửa id section thành sec-ung-tuyen) -->
    <section id="sec-ung-tuyen" style="padding: 70px 5%; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #fff;">
        <div style="max-width: 800px; margin: 0 auto; background: #fff; padding: 45px; border-radius: 16px; color: #334155; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
            <div style="text-align: center; margin-bottom: 30px;">
                <h2 style="color: #0f172a; font-size: 26px; font-weight: 800; margin-bottom: 8px;">Đăng Ký Ứng Tuyển Trực Tuyến</h2>
                <p style="color: #64748b; font-size: 14px;">Điền thông tin và đính kèm CV, bộ phận tuyển dụng sẽ liên hệ lại với bạn trong thời gian sớm nhất.</p>
            </div>

            <form action="/careers/apply" method="POST" enctype="multipart/form-data" id="ung-tuyen-form">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 15px;">
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 6px; color: #1e293b;">Họ và tên *</label>
                        <input type="text" name="name" required placeholder="Nhập họ tên đầy đủ" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box;">
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 6px; color: #1e293b;">Số điện thoại *</label>
                        <input type="tel" name="phone" required placeholder="Ví dụ: 0901234567" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box;">
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 15px;">
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 6px; color: #1e293b;">Email liên hệ *</label>
                        <input type="email" name="email" required placeholder="Ví dụ: email@domain.com" style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box;">
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 6px; color: #1e293b;">Vị trí ứng tuyển *</label>
                        <select name="position" required style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box; background: #fff;">
                            <% if (typeof jobs !== 'undefined' && jobs.length > 0) { %>
                                <% jobs.forEach(job => { %>
                                    <option value="<%= job.title %>"><%= job.title %></option>
                                <% }) %>
                            <% } else { %>
                                <option value="Kỹ Sư Vận Hành Xử Lý Nước Thải">Kỹ Sư Vận Hành Xử Lý Nước Thải</option>
                                <option value="Kỹ Sư Thi Công Hạ Tầng Giao Thông">Kỹ Sư Thi Công Hạ Tầng Giao Thông</option>
                                <option value="Chuyên Viên Kinh Doanh Giải Pháp">Chuyên Viên Kinh Doanh Giải Pháp</option>
                            <% } %>
                            <option value="Vị trí khác / Thực tập sinh">Vị trí khác / Thực tập sinh</option>
                        </select>
                    </div>
                </div>

                <div style="margin-bottom: 15px;">
                    <label style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 6px; color: #1e293b;">Đính kèm CV (PDF / Word) *</label>
                    <input type="file" name="cv_file" required accept=".pdf,.doc,.docx" style="width: 100%; padding: 10px; border: 1px dashed #cbd5e1; border-radius: 8px; font-size: 14px; background: #f8fafc; box-sizing: border-box;">
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 6px; color: #1e293b;">Giới thiệu ngắn / Lời nhắn</label>
                    <textarea name="message" rows="4" placeholder="Chia sẻ thêm về kinh nghiệm hoặc định hướng nghề nghiệp của bạn..." style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box; resize: vertical;"></textarea>
                </div>

                <button type="submit" style="width: 100%; background: #0284c7; color: #fff; border: none; padding: 14px; border-radius: 8px; font-weight: 700; font-size: 15px; cursor: pointer; transition: background 0.2s;">Gửi Hồ Sơ Ứng Tuyển</button>
            </form>
        </div>
    </section>

</main>

<!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const applyForm = document.getElementById('ung-tuyen-form');

    if (applyForm instanceof HTMLFormElement) {
        applyForm.addEventListener('submit', async function (e) {
            e.preventDefault(); // Chặn hành vi submit mặc định để không nhảy sang trang JSON

            const formData = new FormData(applyForm);

            // Bật hiệu ứng Loading SweetAlert2
            Swal.fire({
                title: 'Đang gửi hồ sơ...',
                text: 'Vui lòng chờ trong giây lát.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const response = await fetch('/careers/apply', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: result.message,
                        confirmButtonText: 'Đã hiểu'
                    }).then(() => {
                        applyForm.reset(); // Đặt lại form sau khi nộp thành công
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Thất bại',
                        text: result.message || 'Có lỗi xảy ra, vui lòng thử lại.',
                        confirmButtonText: 'Đóng'
                    });
                }
            } catch (error) {
                console.error('Lỗi khi gửi form:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi kết nối',
                    text: 'Không thể kết nối tới máy chủ, vui lòng kiểm tra lại đường truyền.',
                    confirmButtonText: 'Đóng'
                });
            }
        });
    }
});
</script>

<%- include('components/footer') %>