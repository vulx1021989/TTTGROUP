<%- include('components/header', { title: 'Cơ Hội Nghề Nghiệp - TTT Group' }) %>

<!-- NHÚNG FILE CSS RIÊNG -->
<link rel="stylesheet" href="/css/career.css">

<main class="main-wrapper-career">

    <!-- 1. HERO BANNER TUYỂN DỤNG -->
    <section class="career-hero">
        <div class="career-hero-container">
            <span class="career-badge">Careers at TTT Group</span>
            <h1 class="career-hero-title">Cơ Hội Nghề Nghiệp Tại TTT Group</h1>
            <p class="career-hero-desc">
                Đồng hành cùng TTT Group để xây dựng sự nghiệp vững chắc trong lĩnh vực hạ tầng, môi trường và công nghệ xanh. Chúng tôi luôn chào đón các nhân tài nhiệt huyết!
            </p>
        </div>
    </section>

    <!-- 2. VĂN HÓA & MÔI TRƯỜNG LÀM VIỆC -->
    <section class="career-culture-section">
        <div class="career-container">
            <div class="career-section-header">
                <h2 class="career-section-title">Tại sao bạn nên gia nhập TTT Group?</h2>
                <p class="career-section-desc">Môi trường làm việc chuyên nghiệp, sáng tạo và nhiều cơ hội phát triển bản thân.</p>
            </div>

            <div class="culture-grid">
                <div class="culture-card">
                    <div class="culture-icon-box bg-green-light">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <h3 class="culture-card-title">Lộ Trình Thăng Tiến Rõ Ràng</h3>
                    <p class="culture-card-desc">Đánh giá năng lực công bằng, cơ hội thăng tiến rộng mở theo quy mô phát triển không ngừng của tập đoàn.</p>
                </div>

                <div class="culture-card">
                    <div class="culture-icon-box bg-blue-light">
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                    </div>
                    <h3 class="culture-card-title">Thu Nhập & Phúc Lợi Cạnh Tranh</h3>
                    <p class="culture-card-desc">Lương thưởng hấp dẫn, chế độ bảo hiểm đầy đủ, thưởng hiệu quả công việc và các phúc lợi định kỳ.</p>
                </div>

                <div class="culture-card">
                    <div class="culture-icon-box bg-amber-light">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <h3 class="culture-card-title">Đào Tạo & Phát Triển Kỹ Năng</h3>
                    <p class="culture-card-desc">Thường xuyên tham gia các khóa đào tạo chuyên sâu về kỹ thuật hạ tầng, công nghệ môi trường và kỹ năng quản lý.</p>
                </div>

                <div class="culture-card">
                    <div class="culture-icon-box bg-purple-light">
                        <i class="fa-solid fa-people-group"></i>
                    </div>
                    <h3 class="culture-card-title">Môi Trường Năng Động</h3>
                    <p class="culture-card-desc">Đội ngũ nhân sự trẻ trung, chuyên nghiệp, gắn kết và luôn sẵn sàng hỗ trợ đồng nghiệp trong mọi dự án.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. DANH SÁCH VỊ TRÍ TUYỂN DỤNG ĐỘNG TỪ DATABASE -->
    <section class="job-list-section">
        <div class="career-container">
            <div class="career-section-header">
                <h2 class="career-section-title" style="font-size: 30px;">Vị Trí Đang Tuyển Dụng</h2>
                <p class="career-section-desc">Hãy chọn vị trí phù hợp với năng lực và gửi hồ sơ ứng tuyển ngay hôm nay.</p>
            </div>

            <div class="job-grid">
                <% if (typeof jobs !== 'undefined' && jobs.length > 0) { %>
                    <% jobs.forEach(job => { %>
                        <div class="job-card">
                            <div>
                                <h3 class="job-title"><%= job.title %></h3>
                                <div class="job-meta">
                                    <span><i class="fa-solid fa-location-dot" style="color: #059669; margin-right: 5px;"></i> <%= job.location || 'TP. Hồ Chí Minh' %></span>
                                    <span><i class="fa-solid fa-briefcase" style="color: #0284c7; margin-right: 5px;"></i> <%= job.type || 'Toàn thời gian' %></span>
                                </div>
                                <p class="job-desc">
                                    <%= job.description %>
                                </p>
                            </div>
                            <a href="#sec-ung-tuyen" class="btn-apply-job">Ứng Tuyển Ngay</a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <!-- Fallback hiển thị tin mẫu nếu chưa có dữ liệu DB -->
                    <div class="job-card">
                        <div>
                            <h3 class="job-title">Kỹ Sư Vận Hành Xử Lý Nước Thải</h3>
                            <p class="job-desc">Trực tiếp vận hành, giám sát các hệ thống xử lý nước thải công nghiệp và sinh hoạt...</p>
                        </div>
                        <a href="#sec-ung-tuyen" class="btn-apply-job" style="margin-top: 15px;">Ứng Tuyển Ngay</a>
                    </div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- 4. FORM ỨNG TUYỂN NHANH -->
    <section id="sec-ung-tuyen" class="apply-form-section">
        <div class="apply-form-wrapper">
            <div style="text-align: center; margin-bottom: 30px;">
                <h2 style="color: #0f172a; font-size: 26px; font-weight: 800; margin-bottom: 8px;">Đăng Ký Ứng Tuyển Trực Tuyến</h2>
                <p style="color: #64748b; font-size: 14px;">Điền thông tin và đính kèm CV, bộ phận tuyển dụng sẽ liên hệ lại với bạn trong thời gian sớm nhất.</p>
            </div>

            <form action="/careers/apply" method="POST" enctype="multipart/form-data" id="ung-tuyen-form">
                <div class="form-grid-2cols">
                    <div class="form-group">
                        <label class="form-label">Họ và tên *</label>
                        <input type="text" name="name" required placeholder="Nhập họ tên đầy đủ" class="form-input">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Số điện thoại *</label>
                        <input type="tel" name="phone" required placeholder="Ví dụ: 0901234567" class="form-input">
                    </div>
                </div>

                <div class="form-grid-2cols">
                    <div class="form-group">
                        <label class="form-label">Email liên hệ *</label>
                        <input type="email" name="email" required placeholder="Ví dụ: email@domain.com" class="form-input">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Vị trí ứng tuyển *</label>
                        <select name="position" required class="form-select">
                            <% if (typeof jobs !== 'undefined' && jobs.length > 0) { %>
                                <% jobs.forEach(job => { %>
                                    <option value="<%= job.title %>"><%= job.title %></option>
                                <% }) %>
                            <% } else { %>
                                <option value="Kỹ Sư Vận Hành Xử Lý Nước Thải">Kỹ Sư Vận Hành Xử Lý Nước Thải</option>
                                <option value="Kỹ Sư Thi Công Hạ Tầng Giao Thông">Kỹ Sư Thi Công Hạ Tầng Giao Thông</option>
                                <option value="Chuyên Viên Kinh Doanh Giải Pháp">Chuyên Viên Kinh Doanh Giải Pháp</option>
                            <% } %>
                            <option value="Vị trí khác / Thực tập sinh">Vị trí khác / Thực tập sinh</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Đính kèm CV (PDF / Word) *</label>
                    <input type="file" name="cv_file" required accept=".pdf,.doc,.docx" class="form-file">
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label class="form-label">Giới thiệu ngắn / Lời nhắn</label>
                    <textarea name="message" rows="4" placeholder="Chia sẻ thêm về kinh nghiệm hoặc định hướng nghề nghiệp của bạn..." class="form-textarea"></textarea>
                </div>

                <button type="submit" class="btn-submit-form">Gửi Hồ Sơ Ứng Tuyển</button>
            </form>
        </div>
    </section>

</main>

<!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const applyForm = document.getElementById('ung-tuyen-form');

    if (applyForm instanceof HTMLFormElement) {
        applyForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(applyForm);

            Swal.fire({
                title: 'Đang gửi hồ sơ...',
                text: 'Vui lòng chờ trong giây lát.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const response = await fetch('/careers/apply', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: result.message,
                        confirmButtonText: 'Đã hiểu'
                    }).then(() => {
                        applyForm.reset();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Thất bại',
                        text: result.message || 'Có lỗi xảy ra, vui lòng thử lại.',
                        confirmButtonText: 'Đóng'
                    });
                }
            } catch (error) {
                console.error('Lỗi khi gửi form:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi kết nối',
                    text: 'Không thể kết nối tới máy chủ, vui lòng kiểm tra lại đường truyền.',
                    confirmButtonText: 'Đóng'
                });
            }
        });
    }
});
</script>

<%- include('components/footer') %>