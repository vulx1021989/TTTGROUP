<%- include('components/header', { title: 'Về Chúng Tôi - TTT' }) %>

<!-- MAIN CONTENT - VỀ CHÚNG TÔI -->
<main class="main-wrapper" style="background-color: #f8fafc; min-height: 70vh;">

    <!-- 1. BANNER / HEADER TRANG -->
    <div style="background: linear-gradient(135deg, #1e3d7b 0%, #0092ca 100%); color: #fff; padding: 60px 20px; text-align: center;">
        <div style="max-width: 800px; margin: 0 auto;">
            <span style="color: #00cba0; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Giới Thiệu Chung</span>
            <h1 style="font-size: 36px; font-weight: 800; margin: 10px 0 15px 0;">Về Chúng Tôi - TTT</h1>
            <p style="font-size: 16px; color: #e2e8f0; line-height: 1.6;">
                Tiên phong trong lĩnh vực Vận hành, Bảo trì, Cải tạo hệ thống xử lý nước và nước thải với nền tảng công nghệ vững chắc từ hệ sinh thái Group.
            </p>
        </div>
    </div>

    <!-- 2. VỀ CHÚNG TÔI (Giới thiệu chung & Mạng lưới Group) -->
    <section class="about-section" style="padding: 60px 5%; background-color: #fff;">
        <div class="container" style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center;">
            <div>
                <span style="color: #0092ca; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Về Chúng Tôi</span>
                <h2 style="font-size: 28px; color: #1e3d7b; font-weight: 800; margin: 10px 0 20px 0;">Nền tảng vững chắc từ chuyên môn & công nghệ</h2>
                
                <p style="color: #334155; font-size: 15px; line-height: 1.7; margin-bottom: 15px;">
                    <strong>TTT</strong> là công ty cổ phần được thành lập và phát triển từ đội ngũ nhân lực trình độ cao, có bề dày kinh nghiệm được kế thừa và tiếp nối từ công ty sở hữu phần vốn là <strong>Công ty CP Kỹ thuật Công nghiệp Môi trường Tài Nguyên Xanh (Tổng thầu EPC, 2010)</strong>.
                </p>
                <p style="color: #334155; font-size: 15px; line-height: 1.7; margin-bottom: 20px;">
                    Với sứ mệnh riêng của mình, <strong>TTT</strong> được trao những nguồn lực vững mạnh về công nghệ, kỹ thuật đã được đúc kết trong suốt hơn 10 năm hoạt động của các công ty trong Group để từ đó phát triển các Dịch vụ & Giải pháp tối ưu trong mảng Cải tạo, Vận hành & Bảo trì các hệ thống xử lý nước, nước thải.
                </p>

                <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px;">
                    <li style="font-weight: 600; color: #12264e;"><i class="fa-solid fa-check-circle" style="color: #00cba0; margin-right: 8px;"></i> Hệ thống quản lý chất lượng tiêu chuẩn quốc tế</li>
                    <li style="font-weight: 600; color: #12264e;"><i class="fa-solid fa-check-circle" style="color: #00cba0; margin-right: 8px;"></i> Công nghệ tiên tiến, tự động hóa cao từ hệ sinh thái Group</li>
                    <li style="font-weight: 600; color: #12264e;"><i class="fa-solid fa-check-circle" style="color: #00cba0; margin-right: 8px;"></i> Hỗ trợ kỹ thuật và bảo trì toàn diện 24/7</li>
                </ul>
            </div>

            <!-- Khối hiển thị mạng lưới công ty trong Group -->
            <div style="background: #f8fafc; border-radius: 12px; padding: 30px; border: 1px solid #e2e8f0; text-align: center;">
                <div style="font-size: 16px; font-weight: 800; color: #1e3d7b; margin-bottom: 15px; text-transform: uppercase;">Mạng Lưới Các Đơn Vị Trong Group</div>
                <p style="font-size: 13px; color: #64748b; margin-bottom: 25px;">Sự kết hợp sức mạnh từ các thành viên và đối tác chiến lược</p>
                
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 20px;">
                    <div style="background: #fff; padding: 12px 8px; border-radius: 8px; border: 1px solid #cbd5e1; font-weight: 700; font-size: 12px; color: #1e3d7b; display: flex; align-items: center; justify-content: center;">TTT</div>
                    <div style="background: #fff; padding: 12px 8px; border-radius: 8px; border: 1px solid #cbd5e1; font-weight: 700; font-size: 12px; color: #0092ca; display: flex; align-items: center; justify-content: center;">MAPTREE</div>
                    <div style="background: #fff; padding: 12px 8px; border-radius: 8px; border: 1px solid #cbd5e1; font-weight: 700; font-size: 12px; color: #12264e; display: flex; align-items: center; justify-content: center;">Nuplex</div>
                    <div style="background: #fff; padding: 12px 8px; border-radius: 8px; border: 1px solid #cbd5e1; font-weight: 700; font-size: 12px; color: #dc2626; display: flex; align-items: center; justify-content: center;">ACE</div>
                    <div style="background: #fff; padding: 12px 8px; border-radius: 8px; border: 1px solid #cbd5e1; font-weight: 700; font-size: 12px; color: #0092ca; display: flex; align-items: center; justify-content: center;">SGEEC</div>
                    <div style="background: #fff; padding: 12px 8px; border-radius: 8px; border: 1px solid #cbd5e1; font-weight: 700; font-size: 12px; color: #00cba0; display: flex; align-items: center; justify-content: center;">Cleaning</div>
                </div>

                <div style="background: linear-gradient(135deg, #00cba0 0%, #0092ca 100%); color: #fff; padding: 15px; border-radius: 8px; font-weight: 800; font-size: 14px; letter-spacing: 0.5px;">
                    GR INDTECH
                </div>
            </div>
        </div>
    </section>

    <!-- 3. TẦM NHÌN & SỨ MỆNH -->
    <section class="vision-mission-section" style="padding: 60px 5%; background-color: #f8fafc;">
        <div class="container" style="max-width: 1200px; margin: 0 auto;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
                
                <!-- Tầm nhìn -->
                <div style="background: #fff; border-radius: 12px; padding: 35px; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
                    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
                        <div style="background: #e0f2fe; color: #0092ca; width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22px;"><i class="fa-solid fa-eye"></i></div>
                        <h3 style="font-size: 22px; color: #1e3d7b; font-weight: 800; text-transform: uppercase; margin: 0;">Tầm Nhìn</h3>
                    </div>
                    <p style="color: #334155; font-size: 15px; line-height: 1.7;">
                        Phấn đấu trở thành công ty Dịch vụ O&M hàng đầu Việt Nam về xử lý nước và nước thải, chuyên nghiệp và uy tín vươn tầm quốc tế.
                    </p>
                </div>

                <!-- Sứ mệnh -->
                <div style="background: #fff; border-radius: 12px; padding: 35px; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
                    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
                        <div style="background: #e6fffa; color: #00cba0; width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22px;"><i class="fa-solid fa-bullseye"></i></div>
                        <h3 style="font-size: 22px; color: #1e3d7b; font-weight: 800; text-transform: uppercase; margin: 0;">Sứ Mệnh</h3>
                    </div>
                    <p style="color: #334155; font-size: 14px; line-height: 1.6; margin-bottom: 15px;">
                        Nỗ lực xây dựng niềm tin trong lòng Khách hàng, đối tác, trong cộng đồng và trong từng nhân viên nhằm mang lại cho họ những giá trị cao nhất với nhiệm vụ:
                    </p>
                    <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; color: #475569; font-size: 14px; line-height: 1.5;">
                        <li style="display: flex; gap: 10px;"><i class="fa-solid fa-square-check" style="color: #00cba0; margin-top: 3px;"></i> <span>Cung cấp sản phẩm dịch vụ đúng chất lượng, đúng thời hạn và giá thành cạnh tranh.</span></li>
                        <li style="display: flex; gap: 10px;"><i class="fa-solid fa-square-check" style="color: #00cba0; margin-top: 3px;"></i> <span>Nâng cao năng lực và hoàn thiện tổ chức để trở thành đối tác tin cậy, chuyên nghiệp.</span></li>
                        <li style="display: flex; gap: 10px;"><i class="fa-solid fa-square-check" style="color: #00cba0; margin-top: 3px;"></i> <span>Kinh doanh và tăng trưởng hiệu quả nhằm phục vụ lợi ích của công ty và xã hội.</span></li>
                        <li style="display: flex; gap: 10px;"><i class="fa-solid fa-square-check" style="color: #00cba0; margin-top: 3px;"></i> <span>Xây dựng môi trường làm việc, hợp tác và phát triển sự nghiệp tốt nhất cho cán bộ nhân viên. Tăng trưởng của công ty luôn gắn liền với việc nâng cao chất lượng sống và làm việc của mỗi thành viên trong công ty.</span></li>
                        <li style="display: flex; gap: 10px;"><i class="fa-solid fa-square-check" style="color: #00cba0; margin-top: 3px;"></i> <span>Có trách nhiệm trong bảo vệ môi trường và phát triển bền vững.</span></li>
                    </ul>
                </div>

            </div>
        </div>
    </section>

    <!-- 4. GIÁ TRỊ CỐT LÕI -->
    <section class="core-values-section" style="padding: 60px 5%; background-color: #fff;">
        <div class="container" style="max-width: 1200px; margin: 0 auto;">
            <div style="text-align: center; max-width: 800px; margin: 0 auto 50px auto;">
                <span style="color: #0092ca; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Kim Chỉ Nam Hoạt Động</span>
                <h2 style="font-size: 30px; color: #1e3d7b; font-weight: 800; margin: 10px 0;">Giá Trị Cốt Lõi</h2>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
                
                <!-- Giá trị 1: Tâm huyết -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 30px; transition: 0.3s;">
                    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                        <div style="background: #00cba0; color: #fff; width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px;"><i class="fa-solid fa-heart-pulse"></i></div>
                        <h3 style="font-size: 18px; color: #1e3d7b; font-weight: 700; margin: 0;">Tâm Huyết</h3>
                    </div>
                    <p style="color: #475569; font-size: 14px; line-height: 1.6; margin-bottom: 12px;">
                        Chúng tôi luôn nỗ lực và tâm huyết trong mọi hoạt động, xây dựng mối quan hệ với khách hàng, đối tác, đồng nghiệp, nhà đầu tư và xã hội bằng sự thiện chí, tinh thần thân ái, nhân văn.
                    </p>
                    <p style="color: #475569; font-size: 14px; line-height: 1.6;">
                        Chúng tôi luôn coi trọng người lao động như là tài sản quý giá, xây dựng môi trường làm việc năng động, sáng tạo, công bằng.
                    </p>
                </div>

                <!-- Giá trị 2: Đổi mới -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 30px; transition: 0.3s;">
                    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                        <div style="background: #0092ca; color: #fff; width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px;"><i class="fa-solid fa-rocket"></i></div>
                        <h3 style="font-size: 18px; color: #1e3d7b; font-weight: 700; margin: 0;">Đổi Mới</h3>
                    </div>
                    <p style="color: #475569; font-size: 14px; line-height: 1.6;">
                        Thế giới không ngừng vận động, khi đứng lại cũng đồng nghĩa là lùi lại phía sau. Sự đổi mới giúp chúng tôi luôn tiến lên phía trước, nắm bắt và chủ động với những xu hướng phát triển của thị trường để thích nghi và thành công.
                    </p>
                </div>

                <!-- Giá trị 3: Chuyên nghiệp -->
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 30px; transition: 0.3s;">
                    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
                        <div style="background: #12264e; color: #fff; width: 45px; height: 45px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px;"><i class="fa-solid fa-briefcase"></i></div>
                        <h3 style="font-size: 18px; color: #1e3d7b; font-weight: 700; margin: 0;">Chuyên Nghiệp</h3>
                    </div>
                    <p style="color: #475569; font-size: 14px; line-height: 1.6;">
                        Với chúng tôi, chuyên nghiệp đơn giản là nhanh hơn, gọn hơn và hiệu quả hơn. Chìa khóa để chúng tôi đạt được sự chuyên nghiệp là sự am hiểu trong các lĩnh vực chuyên môn, sự tuân thủ, sự đổi mới liên tục và tính khoa học trong mỗi quy trình, nghiệp vụ.
                    </p>
                </div>

            </div>
        </div>
    </section>

</main>

<%- include('components/footer') %>