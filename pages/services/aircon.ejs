                    </div>
                    <div class="infra-form-group">
                        <label class="infra-form-label">Họ và Tên Người Đại Diện *</label>
                        <input type="text" name="name" required placeholder="Ví dụ: Nguyễn Văn A" class="infra-form-input">
                    </div>
                </div>

                <div class="infra-form-grid">
                    <div class="infra-form-group">
                        <label class="infra-form-label">Số Điện Thoại Liên Hệ *</label>
                        <input type="tel" name="phone" required placeholder="Ví dụ: 0946117878" class="infra-form-input">
                    </div>
                    <div class="infra-form-group">
                        <label class="infra-form-label">Hạng Mục Cần Duy Tu *</label>
                        <select name="facility_type" required class="infra-form-select">
                            <option value="Nao vet va duy tu he thong thoat nuoc">Nạo vét & Duy tu hệ thống thoát nước</option>
                            <option value="Sua chua mat duong asphalt / vi he">Sửa chữa mặt đường Asphalt / Vỉa hè / Bó vỉa</option>
                            <option value="Duy tu tron goi ha tang KCN / Do thi">Duy tu trọn gói hạ tầng KCN / Khu đô thị</option>
                            <option value="Khac">Hạng mục khác</option>
                        </select>
                    </div>
                </div>

                <div class="infra-form-group" style="margin-bottom: 20px;">
                    <label class="infra-form-label">Mô Tả Hiện Trạng / Khối Lượng Dự Kiến</label>
                    <textarea name="message" rows="4" placeholder="Ví dụ: Cần nạo vét 2km cống hộp KCN, sửa chữa các vị trí mặt đường nhựa bị lún nứt..." class="infra-form-textarea"></textarea>
                </div>

                <button type="submit" class="btn-submit-infra">
                    Gửi Yêu Cầu Khảo Sát & Báo Giá
                </button>
            </form>
        </div>
    </section>

</main>

<!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const infraForm = document.getElementById('infrastructure-form');

    if (infraForm instanceof HTMLFormElement) {
        infraForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(infraForm);
            const data = Object.fromEntries(formData.entries());

            Swal.fire({
                title: 'Đang gửi yêu cầu...',
                text: 'Kỹ sư TTT Group đang tiếp nhận dữ liệu.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const response = await fetch('/contact/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã nhận yêu cầu!',
                        text: 'Kỹ sư chuyên trách hạ tầng của TTT Group sẽ liên hệ lại ngay lập tức.',
                        confirmButtonText: 'Đã hiểu'
                    }).then(() => {
                        infraForm.reset();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Thất bại',
                        text: result.message || 'Có lỗi xảy ra, vui lòng thử lại.',
                        confirmButtonText: 'Đóng'
                    });
                }
            } catch (error) {
                console.error('Lỗi gửi form:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi kết nối',
                    text: 'Không thể kết nối máy chủ, vui lòng kiểm tra lại đường truyền.',
                    confirmButtonText: 'Đóng'
                });
            }
        });
    }
});
</script>

