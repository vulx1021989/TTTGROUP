<!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const infraForm = document.getElementById('infrastructure-form');

    if (infraForm instanceof HTMLFormElement) {
        infraForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(infraForm);
            const data = Object.fromEntries(formData.entries());

            Swal.fire({
                title: 'Đang gửi yêu cầu...',
                text: 'Kỹ sư TTT Group đang tiếp nhận dữ liệu.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const response = await fetch('/contact/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã nhận yêu cầu!',
                        text: 'Kỹ sư chuyên trách hạ tầng của TTT Group sẽ liên hệ lại ngay lập tức.',
                        confirmButtonText: 'Đã hiểu'
                    }).then(() => {
                        infraForm.reset();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Thất bại',
                        text: result.message || 'Có lỗi xảy ra, vui lòng thử lại.',
                        confirmButtonText: 'Đóng'
                    });
                }
            } catch (error) {
                console.error('Lỗi gửi form:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi kết nối',
                    text: 'Không thể kết nối máy chủ, vui lòng kiểm tra lại đường truyền.',
                    confirmButtonText: 'Đóng'
                });
            }
        });
    }
});
</script>

