<!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const epcForm = document.getElementById('epc-wastewater-form');

    if (epcForm instanceof HTMLFormElement) {
        epcForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(epcForm);
            const data = Object.fromEntries(formData.entries());

            Swal.fire({
                title: 'Đang gửi thông tin...',
                text: 'Kỹ sư TTT Group đang tiếp nhận dữ liệu.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const response = await fetch('/contact/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã nhận yêu cầu!',
                        text: 'Chuyên gia môi trường của TTT Group sẽ liên hệ lại với Quý vị ngay lập tức.',
                        confirmButtonText: 'Đã hiểu'
                    }).then(() => {
                        epcForm.reset();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Thất bại',
                        text: result.message || 'Có lỗi xảy ra, vui lòng thử lại.',
                        confirmButtonText: 'Đóng'
                    });
                }
            } catch (error) {
                console.error('Lỗi gửi form:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi kết nối',
                    text: 'Không thể kết nối máy chủ, vui lòng kiểm tra lại đường truyền.',
                    confirmButtonText: 'Đóng'
                });
            }
        });
    }
});
</script>

