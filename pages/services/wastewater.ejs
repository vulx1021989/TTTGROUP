<%- include('../components/header', { title: 'Thiết Kế Thi Công Xử Lý Nước Thải - TTT' }) %>

<!-- MAIN CONTENT - THIẾT KẾ THI CÔNG XỬ LÝ NƯỚC THẢI -->
<main class="main-wrapper" style="padding: 50px 0; background-color: #f8fafc; min-height: 70vh;">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 15px;">
        
        <!-- HEADER SECTION -->
        <div style="text-align: center; max-width: 800px; margin: 0 auto 50px auto;">
            <span style="color: #0092ca; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Tổng Thầu Môi Trường Uy Tín</span>
            <h1 style="font-size: 34px; color: #1e3d7b; font-weight: 800; margin: 10px 0 15px 0;">Thiết Kế & Thi Công Hệ Thống Xử Lý Nước Thải</h1>
            <p style="color: #475569; font-size: 16px; line-height: 1.6;">
                Cung cấp giải pháp EPC (Thiết kế - Cung cấp thiết bị - Xây lắp) trọn gói cho khu công nghiệp, nhà máy sản xuất, bệnh viện, khu đô thị với công nghệ tiên tiến, tối ưu chi phí đầu tư và vận hành.
            </p>
        </div>

        <!-- 1. TỔNG QUAN GIẢI PHÁP EPC -->
        <div style="background: #fff; padding: 40px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; margin-bottom: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; align-items: center;">
            <div>
                <div style="color: #0066cc; font-size: 40px; margin-bottom: 15px;"><i class="fa-solid fa-drafting-compass"></i></div>
                <h2 style="font-size: 22px; color: #1e3d7b; font-weight: 800; margin-bottom: 15px;">Năng Lực Thiết Kế & Thi Công Trọn Gói</h2>
                <p style="color: #555; font-size: 15px; line-height: 1.7; margin-bottom: 15px;">
                    Với đội ngũ kỹ sư môi trường, cơ điện và xây dựng giàu kinh nghiệm, TTT trực tiếp khảo sát, lên bản vẽ thiết kế công nghệ tối ưu dựa trên đặc thù nguồn thải, diện tích mặt bằng và ngân sách của chủ đầu tư.
                </p>
                <p style="color: #555; font-size: 15px; line-height: 1.7;">
                    Chúng tôi cam kết chất lượng công trình vững chắc, thiết bị chính hãng, bàn giao đúng tiến độ và đảm bảo nước thải sau xử lý đạt chuẩn quy định pháp luật môi trường.
                </p>
            </div>
            <div style="background: #f0f4f8; padding: 30px; border-radius: 10px; border: 1px solid #d9e2ec;">
                <h3 style="font-size: 18px; color: #12264e; font-weight: 700; margin-bottom: 20px;"><i class="fa-solid fa-circle-check" style="color: #0066cc; margin-right: 8px;"></i> Cam Kết Dự Án Từ TTT</h3>
                <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px; color: #334155; font-size: 14px;">
                    <li style="display: flex; gap: 10px;"><i class="fa-solid fa-check" style="color: #0066cc; margin-top: 3px;"></i> <span>Tối ưu 20-30% chi phí đầu tư ban đầu và chi phí vận hành (CAPEX & OPEX).</span></li>
                    <li style="display: flex; gap: 10px;"><i class="fa-solid fa-check" style="color: #0066cc; margin-top: 3px;"></i> <span>Ứng dụng công nghệ xử lý hiện đại (MBBR, MBR, SBR, AAO...).</span></li>
                    <li style="display: flex; gap: 10px;"><i class="fa-solid fa-check" style="color: #0066cc; margin-top: 3px;"></i> <span>Bảo hành công trình dài hạn, hỗ trợ chuyển giao công nghệ tận tình.</span></li>
                </ul>
            </div>
        </div>

        <!-- 2. QUY TRÌNH TRIỂN KHAI DỰ ÁN (EPC) -->
        <div style="margin-bottom: 50px;">
            <div style="text-align: center; max-width: 700px; margin: 0 auto 35px auto;">
                <span style="color: #0092ca; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Quy Trình Chuẩn Hóa</span>
                <h2 style="font-size: 28px; color: #1e3d7b; font-weight: 800; margin-top: 5px;">Các Bước Triển Khai Thi Công Hệ Thống</h2>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;">
                <!-- Bước 1 -->
                <div style="background: #fff; padding: 25px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 4px 10px rgba(0,0,0,0.02); position: relative;">
                    <span style="position: absolute; top: 15px; right: 20px; font-size: 24px; font-weight: 800; color: #cbd5e1;">01</span>
                    <div style="color: #0066cc; font-size: 26px; margin-bottom: 12px;"><i class="fa-solid fa-magnifying-glass-chart"></i></div>
                    <h3 style="font-size: 16px; color: #12264e; font-weight: 700; margin-bottom: 8px;">Khảo Sát & Phân Tích Mẫu</h3>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.6;">Lấy mẫu nước thải, phân tích thành phần tính chất ô nhiễm và khảo sát thực địa mặt bằng lắp đặt.</p>
                </div>

                <!-- Bước 2 -->
                <div style="background: #fff; padding: 25px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 4px 10px rgba(0,0,0,0.02); position: relative;">
                    <span style="position: absolute; top: 15px; right: 20px; font-size: 24px; font-weight: 800; color: #cbd5e1;">02</span>
                    <div style="color: #0066cc; font-size: 26px; margin-bottom: 12px;"><i class="fa-solid fa-pen-ruler"></i></div>
                    <h3 style="font-size: 16px; color: #12264e; font-weight: 700; margin-bottom: 8px;">Thiết Kế Bản Vẽ & Công Nghệ</h3>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.6;">Lập bản vẽ thiết kế thi công chi tiết, lựa chọn dây chuyền công nghệ xử lý phù hợp và tối ưu nhất.</p>
                </div>

                <!-- Bước 3 -->
                <div style="background: #fff; padding: 25px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 4px 10px rgba(0,0,0,0.02); position: relative;">
                    <span style="position: absolute; top: 15px; right: 20px; font-size: 24px; font-weight: 800; color: #cbd5e1;">03</span>
                    <div style="color: #0066cc; font-size: 26px; margin-bottom: 12px;"><i class="fa-solid fa-helmet-safety"></i></div>
                    <h3 style="font-size: 16px; color: #12264e; font-weight: 700; margin-bottom: 8px;">Xây Lắp & Lắp Đặt Thiết Bị</h3>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.6;">Thi công phần xây dựng bể chứa, lắp đặt đường ống, máy móc, tủ điện điều khiển đúng kỹ thuật.</p>
                </div>

                <!-- Bước 4 -->
                <div style="background: #fff; padding: 25px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 4px 10px rgba(0,0,0,0.02); position: relative;">
                    <span style="position: absolute; top: 15px; right: 20px; font-size: 24px; font-weight: 800; color: #cbd5e1;">04</span>
                    <div style="color: #0066cc; font-size: 26px; margin-bottom: 12px;"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
                    <h3 style="font-size: 16px; color: #12264e; font-weight: 700; margin-bottom: 8px;">Vận Hành Thử & Bàn Giao</h3>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.6;">Chạy thử nghiệm hệ thống, nuôi cấy vi sinh, kiểm định chất lượng nước đầu ra và bàn giao công nghệ.</p>
                </div>
            </div>
        </div>

        <!-- 3. CÁC LĨNH VỰC ÁP DỤNG -->
        <div style="background: #fff; padding: 40px; border-radius: 12px; border: 1px solid #e2e8f0; margin-bottom: 40px;">
            <div style="text-align: center; max-width: 700px; margin: 0 auto 30px auto;">
                <span style="color: #0092ca; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Đa Dạng Ngành Nghề</span>
                <h2 style="font-size: 26px; color: #1e3d7b; font-weight: 800; margin-top: 5px;">Lĩnh Vực Thi Công Xử Lý Nước Thải Trọng Điểm</h2>
            </div>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
                <div style="background: #f8fafc; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <h3 style="font-size: 16px; font-weight: 700; color: #1e3d7b; margin-bottom: 8px;"><i class="fa-solid fa-industry" style="color: #0066cc; margin-right: 8px;"></i> Nước Thải Khu Công Nghiệp</h3>
                    <p style="color: #64748b; font-size: 14px;">Xử lý nước thải tập trung từ nhiều nhà máy với các tính chất ô nhiễm phức tạp khác nhau.</p>
                </div>
                <div style="background: #f8fafc; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <h3 style="font-size: 16px; font-weight: 700; color: #1e3d7b; margin-bottom: 8px;"><i class="fa-solid fa-utensils" style="color: #0066cc; margin-right: 8px;"></i> Thực Phẩm & Đồ Uống</h3>
                    <p style="color: #64748b; font-size: 14px;">Xử lý nước thải có hàm lượng chất hữu cơ cao (BOD, COD, dầu mỡ) dễ sinh mùi.</p>
                </div>
                <div style="background: #f8fafc; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <h3 style="font-size: 16px; font-weight: 700; color: #1e3d7b; margin-bottom: 8px;"><i class="fa-solid fa-hospital" style="color: #0066cc; margin-right: 8px;"></i> Y Tế & Bệnh Viện</h3>
                    <p style="color: #64748b; font-size: 14px;">Xử lý triệt để mầm bệnh, virus, dược phẩm và các chỉ tiêu vi sinh đặc thù ngành y tế.</p>
                </div>
                <div style="background: #f8fafc; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <h3 style="font-size: 16px; font-weight: 700; color: #1e3d7b; margin-bottom: 8px;"><i class="fa-solid fa-shirt" style="color: #0066cc; margin-right: 8px;"></i> Dệt May & Thủy Sản</h3>
                    <p style="color: #64748b; font-size: 14px;">Xử lý nước thải chứa hàm lượng màu cao, hóa chất tẩy nhuộm hoặc chất rắn lơ lửng lớn.</p>
                </div>
            </div>
        </div>

        <!-- CALL TO ACTION -->
        <div style="text-align: center; background: #1e3d7b; color: #fff; padding: 40px; border-radius: 12px;">
            <h3 style="font-size: 22px; font-weight: 800; margin-bottom: 10px;">Bạn đang tìm nhà thầu thiết kế thi công hệ thống xử lý nước thải uy tín?</h3>
            <p style="color: #cbd5e1; font-size: 15px; margin-bottom: 25px;">Liên hệ ngay với TTT để nhận bản vẽ phác thảo công nghệ và báo giá chi tiết cho dự án của bạn.</p>
            <a href="/contact" class="btn-primary" style="display: inline-block; background-color: #0092ca; color: #fff; padding: 14px 30px; border-radius: 6px; text-decoration: none; font-weight: 700; font-size: 15px; transition: 0.3s;">Nhận Tư Vấn & Báo Giá Miễn Phí</a>
        </div>

    </div>
</main>

<%- include('../components/footer') %>