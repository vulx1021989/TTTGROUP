<%- include('../components/header', { title: 'Chăm Sóc & Duy Trì Cây Xanh - TTT' }) %>

<!-- MAIN CONTENT - CHĂM SÓC & DUY TRÌ CÂY XANH -->
<main class="main-wrapper" style="padding: 50px 0; background-color: #f8fafc; min-height: 70vh;">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 15px;">
        
        <!-- HEADER SECTION -->
        <div style="text-align: center; max-width: 800px; margin: 0 auto 50px auto;">
            <span style="color: #16a34a; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Dịch Vụ Cảnh Quan Chuyên Sâu</span>
            <h1 style="font-size: 34px; color: #1e3d7b; font-weight: 800; margin: 10px 0 15px 0;">Chăm Sóc & Duy Trì Cây Xanh Cảnh Quan Trọn Gói</h1>
            <p style="color: #475569; font-size: 16px; line-height: 1.6;">
                Giải pháp bảo dưỡng cảnh quan toàn diện cho nhà máy, khu công nghiệp, tòa nhà văn phòng và khu đô thị. Giữ gìn không gian xanh luôn tươi tốt, thẩm mỹ và phát triển bền vững theo thời gian.
            </p>
        </div>

        <!-- 1. TỔNG QUAN GIẢI PHÁP -->
        <div style="background: #fff; padding: 40px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; margin-bottom: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; align-items: center;">
            <div>
                <div style="color: #16a34a; font-size: 40px; margin-bottom: 15px;"><i class="fa-solid fa-seedling"></i></div>
                <h2 style="font-size: 22px; color: #1e3d7b; font-weight: 800; margin-bottom: 15px;">Duy Trì Vẻ Đẹp & Sức Sống Cho Cảnh Quan</h2>
                <p style="color: #555; font-size: 15px; line-height: 1.7; margin-bottom: 15px;">
                    Cây xanh và thảm cỏ sau khi hoàn thiện thiết kế nếu không được chăm sóc đúng kỹ thuật sẽ dễ bị sâu bệnh, héo úa hoặc mất dáng. Đội ngũ kỹ thuật viên nông - lâm nghiệp của TTT cung cấp dịch vụ duy trì định kỳ với quy trình khoa học.
                </p>
                <p style="color: #555; font-size: 15px; line-height: 1.7;">
                    Chúng tôi đảm bảo hệ thống cây xanh luôn xanh mát, cắt tỉa gọn gàng, kiểm soát cỏ dại và phòng trừ sâu bệnh kịp thời, tạo ấn tượng chuyên nghiệp cho bộ mặt doanh nghiệp.
                </p>
            </div>
            <div style="background: #f0fdf4; padding: 30px; border-radius: 10px; border: 1px solid #bbf7d0;">
                <h3 style="font-size: 18px; color: #14532d; font-weight: 700; margin-bottom: 20px;"><i class="fa-solid fa-check-to-slot" style="color: #16a34a; margin-right: 8px;"></i> Cam Kết Dịch Vụ Từ TTT</h3>
                <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px; color: #166534; font-size: 14px;">
                    <li style="display: flex; gap: 10px;"><i class="fa-solid fa-check" style="color: #16a34a; margin-top: 3px;"></i> <span>Cây trồng phát triển khỏe mạnh, tỉ lệ sống cao, thay thế kịp thời cây sâu bệnh.</span></li>
                    <li style="display: flex; gap: 10px;"><i class="fa-solid fa-check" style="color: #16a34a; margin-top: 3px;"></i> <span>Sử dụng phân bón và thuốc bảo vệ thực vật an toàn, đúng tiêu chuẩn kỹ thuật.</span></li>
                    <li style="display: flex; gap: 10px;"><i class="fa-solid fa-check" style="color: #16a34a; margin-top: 3px;"></i> <span>Đội ngũ nhân công chuyên nghiệp, tác phong nhanh nhẹn, đúng giờ giấc.</span></li>
                </ul>
            </div>
        </div>

        <!-- 2. CÁC HẠNG MỤC CÔNG VIỆC CHĂM SÓC -->
        <div style="margin-bottom: 50px;">
            <div style="text-align: center; max-width: 700px; margin: 0 auto 35px auto;">
                <span style="color: #16a34a; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Nội Dung Bảo Dưỡng</span>
                <h2 style="font-size: 28px; color: #1e3d7b; font-weight: 800; margin-top: 5px;">Hạng Mục Chăm Sóc & Duy Trì Định Kỳ</h2>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 25px;">
                <!-- Hạng mục 1 -->
                <div style="background: #fff; padding: 25px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 4px 10px rgba(0,0,0,0.02);">
                    <div style="color: #16a34a; font-size: 28px; margin-bottom: 12px;"><i class="fa-solid fa-scissors"></i></div>
                    <h3 style="font-size: 17px; color: #12264e; font-weight: 700; margin-bottom: 10px;">Cắt Tỉa & Tạo Dáng Cây</h3>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.6;">Cắt tỉa cành khô, tạo dáng cho cây bóng mát, cắt xén thảm cỏ định kỳ giữ độ phẳng và thẩm mỹ cao.</p>
                </div>

                <!-- Hạng mục 2 -->
                <div style="background: #fff; padding: 25px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 4px 10px rgba(0,0,0,0.02);">
                    <div style="color: #16a34a; font-size: 28px; margin-bottom: 12px;"><i class="fa-solid fa-droplet"></i></div>
                    <h3 style="font-size: 17px; color: #12264e; font-weight: 700; margin-bottom: 10px;">Tưới Nước & Vận Hành Hệ Thống</h3>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.6;">Duy trì chế độ tưới nước phù hợp theo mùa, kiểm tra và bảo dưỡng hệ thống tưới tự động.</p>
                </div>

                <!-- Hạng mục 3 -->
                <div style="background: #fff; padding: 25px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 4px 10px rgba(0,0,0,0.02);">
                    <div style="color: #16a34a; font-size: 28px; margin-bottom: 12px;"><i class="fa-solid fa-flask"></i></div>
                    <h3 style="font-size: 17px; color: #12264e; font-weight: 700; margin-bottom: 10px;">Bón Phân & Dinh Dưỡng</h3>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.6;">Bổ sung phân bón hữu cơ, phân hóa học định kỳ giúp đất tơi xốp và cây xanh hấp thụ dinh dưỡng tốt nhất.</p>
                </div>

                <!-- Hạng mục 4 -->
                <div style="background: #fff; padding: 25px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 4px 10px rgba(0,0,0,0.02);">
                    <div style="color: #16a34a; font-size: 28px; margin-bottom: 12px;"><i class="fa-solid fa-bug-slash"></i></div>
                    <h3 style="font-size: 17px; color: #12264e; font-weight: 700; margin-bottom: 10px;">Phòng Trừ Sâu Bệnh</h3>
                    <p style="color: #64748b; font-size: 14px; line-height: 1.6;">Phun thuốc phòng trừ sâu bệnh, làm sạch cỏ dại gốc cây, vun xới đất giúp rễ cây hô hấp mạnh mẽ.</p>
                </div>
            </div>
        </div>

        <!-- 3. QUY TRÌNH TRIỂN KHAI DỊCH VỤ -->
        <div style="background: #1e3d7b; color: #fff; padding: 40px; border-radius: 12px; margin-bottom: 40px;">
            <div style="text-align: center; max-width: 700px; margin: 0 auto 35px auto;">
                <span style="color: #4ade80; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Quy Trình Làm Việc</span>
                <h2 style="font-size: 26px; font-weight: 800; margin-top: 5px; color: #fff;">Các Bước Tiếp Nhận & Thực Hiện Chăm Sóc</h2>
            </div>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px;">
                <div style="background: rgba(255,255,255,0.05); padding: 20px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
                    <h3 style="font-size: 15px; font-weight: 700; color: #4ade80; margin-bottom: 8px;">1. Khảo Sát Hiện Trạng</h3>
                    <p style="color: #cbd5e1; font-size: 13px; line-height: 1.5;">Đánh giá chủng loại cây, diện tích thảm cỏ và tình trạng sâu bệnh thực tế.</p>
                </div>
                <div style="background: rgba(255,255,255,0.05); padding: 20px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
                    <h3 style="font-size: 15px; font-weight: 700; color: #4ade80; margin-bottom: 8px;">2. Lập Kế Hoạch & Báo Giá</h3>
                    <p style="color: #cbd5e1; font-size: 13px; line-height: 1.5;">Đưa ra lịch trình chăm sóc cụ thể theo tuần/tháng và gửi báo giá tối ưu.</p>
                </div>
                <div style="background: rgba(255,255,255,0.05); padding: 20px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
                    <h3 style="font-size: 15px; font-weight: 700; color: #4ade80; margin-bottom: 8px;">3. Triển Khai Định Kỳ</h3>
                    <p style="color: #cbd5e1; font-size: 13px; line-height: 1.5;">Đội ngũ nhân công ra quân thực hiện các hạng mục theo đúng cam kết hợp đồng.</p>
                </div>
                <div style="background: rgba(255,255,255,0.05); padding: 20px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">
                    <h3 style="font-size: 15px; font-weight: 700; color: #4ade80; margin-bottom: 8px;">4. Nghiệm Thu & Báo Cáo</h3>
                    <p style="color: #cbd5e1; font-size: 13px; line-height: 1.5;">Báo cáo tiến độ và chất lượng cảnh quan định kỳ hàng tháng với chủ đầu tư.</p>
                </div>
            </div>
        </div>

        <!-- CALL TO ACTION -->
        <div style="text-align: center; background: #fff; padding: 40px; border-radius: 12px; border: 1px solid #e2e8f0;">
            <h3 style="font-size: 22px; color: #1e3d7b; font-weight: 800; margin-bottom: 10px;">Bạn cần tìm đơn vị chăm sóc cảnh quan uy tín cho khuôn viên của mình?</h3>
            <p style="color: #64748b; font-size: 15px; margin-bottom: 25px;">Hãy liên hệ ngay với TTT để được khảo sát miễn phí và nhận báo giá dịch vụ trọn gói tốt nhất.</p>
            <a href="/contact" class="btn-primary" style="display: inline-block; background-color: #16a34a; color: #fff; padding: 14px 30px; border-radius: 6px; text-decoration: none; font-weight: 700; font-size: 15px; transition: 0.3s;">Liên Hệ Tư Vấn Dịch Vụ Này</a>
        </div>

    </div>
</main>

<%- include('../components/footer') %>