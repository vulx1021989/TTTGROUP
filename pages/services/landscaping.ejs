                            <option value="Benh vien / Y te">Bệnh viện / Phòng khám / Y tế</option>
                            <option value="Khu dan cu / Do thi">Khu dân cư / Chung cư / Đô thị</option>
                            <option value="Truong hoc">Trường học / Cơ sở đào tạo</option>
                            <option value="Khac">Loại hình khác</option>
                        </select>
                    </div>
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 6px; color: #1e293b;">Mô Tả Nhu Cầu / Công Suất Trạm (m³/ngày)</label>
                    <textarea name="message" rows="4" placeholder="Ví dụ: Công suất trạm 300m3/ngày, hiện đang gặp tình trạng nước đầu ra có mùi hoặc cần ký hợp đồng vận hành trọn gói..." style="width: 100%; padding: 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box; resize: vertical;"></textarea>
                </div>

                <button type="submit" style="width: 100%; background: #10b981; color: #fff; border: none; padding: 14px; border-radius: 8px; font-weight: 700; font-size: 15px; cursor: pointer; transition: background 0.2s;">
                    Gửi Yêu Cầu Khảo Sát & Nhận Báo Giá
                </button>
            </form>
        </div>
    </section>

</main>

<!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const wwForm = document.getElementById('wastewater-form');

    if (wwForm instanceof HTMLFormElement) {
        wwForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(wwForm);
            const data = Object.fromEntries(formData.entries());

            Swal.fire({
                title: 'Đang gửi thông tin...',
                text: 'Kỹ sư TTT Group đang tiếp nhận dữ liệu.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const response = await fetch('/contact/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã nhận yêu cầu!',
                        text: 'Chuyên gia môi trường của TTT Group sẽ liên hệ lại với Quý đơn vị ngay lập tức.',
                        confirmButtonText: 'Đã hiểu'
                    }).then(() => {
                        wwForm.reset();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Thất bại',
                        text: result.message || 'Có lỗi xảy ra, vui lòng thử lại.',
                        confirmButtonText: 'Đóng'
                    });
                }
            } catch (error) {
                console.error('Lỗi gửi form:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi kết nối',
                    text: 'Không thể kết nối máy chủ, vui lòng kiểm tra lại đường truyền.',
                    confirmButtonText: 'Đóng'
                });
            }
        });
    }
});
</script>

