<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hồ Sơ Năng Lực - TTT Technology</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Cấu hình chuẩn in khổ A4 và ngắt trang */
        @page {
            size: A4;
            margin: 0;
        }
        body {
            background-color: #e2e8f0;
            margin: 0;
            padding: 0;
        }
        .page-container {
            width: 210mm;
            height: 297mm;
            max-width: 210mm;
            max-height: 297mm;
            margin: 0 auto;
            background: white;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            position: relative;
            overflow: hidden;
            page-break-after: always;
            break-after: page;
        }
        @media print {
            body {
                background: transparent;
            }
            .page-container {
                box-shadow: none;
                margin: 0;
            }
        }
        /* Ép font chữ hiển thị cực kỳ sắc nét, mịn màng */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-weight: 500; /* Tăng độ đậm mặc định của toàn bộ văn bản */
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
    </style>
</head>
<body>

    <!-- Trang 1: Trang bìa (được import từ pdf-1.ejs) -->
