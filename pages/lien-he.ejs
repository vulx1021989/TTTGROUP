<%- include('components/header', { title: 'Liên Hệ - TTT Infrastructure' }) %>

<!-- NHÚNG FILE CSS RIÊNG CHO TRANG LIÊN HỆ -->
<link rel="stylesheet" href="/css/lien-he.css">

<!-- MAIN CONTENT - TRANG LIÊN HỆ -->
<main class="main-wrapper-contact">
    <div class="contact-container">
        
        <!-- Tiêu đề trang -->
        <div class="contact-page-header">
            <h2 class="contact-page-title">Liên Hệ Với Chúng Tôi</h2>
            <p class="contact-page-desc">Hãy liên hệ với đội ngũ TTT để nhận tư vấn giải pháp hạ tầng, môi trường và dịch vụ kỹ thuật tối ưu nhất.</p>
        </div>

        <!-- Bố cục 2 cột: Thông tin liên hệ & Form gửi tin nhắn -->
        <div class="contact-grid-2cols">
            
            <!-- Cột 1: Thông tin chi tiết -->
            <div class="contact-info-box">
                <h3 class="contact-box-title">Trụ Sở Chính TTT</h3>
                
                <ul class="contact-info-list">
                    <li class="contact-info-item">
                        <i class="fa-solid fa-location-dot contact-info-icon"></i>
                        <div class="contact-info-text">
                            <strong>Địa chỉ:</strong>
                            <span>49, đường 60-TML, CÁT LÁI, HỒ CHÍ MINH</span>
                        </div>
                    </li>
                    <li class="contact-info-item">
                        <i class="fa-solid fa-phone contact-info-icon"></i>
                        <div class="contact-info-text">
                            <strong>Điện thoại / Hotline:</strong>
                            <span>(84) 094 611 7878</span>
                        </div>
                    </li>
                    <li class="contact-info-item">
                        <i class="fa-solid fa-envelope contact-info-icon"></i>
                        <div class="contact-info-text">
                            <strong>Hộp thư điện tử:</strong>
                            <span>congtymoitruonggr@gmail.com</span>
                        </div>
                    </li>
                    <li class="contact-info-item">
                        <i class="fa-solid fa-clock contact-info-icon"></i>
                        <div class="contact-info-text">
                            <strong>Giờ làm việc:</strong>
                            <span>Thứ Hai - Thứ Sáu: 8:00 - 17:00</span>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- Cột 2: Form gửi tin nhắn liên hệ -->
            <div class="contact-form-box">
                <h3 class="contact-box-title">Gửi Tin Nhắn Cho Chúng Tôi</h3>
                
                <form action="/contact" method="POST" class="contact-form">
                    <div class="contact-form-group">
                        <label>Họ và tên của bạn (*)</label>
                        <input type="text" name="name" placeholder="Nhập họ và tên" required class="contact-form-input">
                    </div>

                    <div class="contact-form-group">
                        <label>Tên Công Ty / Đơn vị</label>
                        <input type="text" name="company" placeholder="Nhập tên công ty hoặc tổ chức" class="contact-form-input">
                    </div>

                    <div class="contact-form-group">
                        <label>Số điện thoại (*)</label>
                        <input type="tel" name="phone" placeholder="Nhập số điện thoại liên hệ" required class="contact-form-input">
                    </div>

                    <!-- Thẻ Selectbox Lựa chọn dịch vụ -->
                    <div class="contact-form-group">
                        <label>Lựa chọn dịch vụ quan tâm (*)</label>
                        <select name="service_id" required class="contact-form-select">
                            <option value="" disabled selected>-- Chọn dịch vụ tư vấn --</option>
                            <% if (servicesMenu && servicesMenu.length > 0) { %>
                                <% servicesMenu.forEach(item => { %>
                                    <option value="<%= item.id %>"><%= item.title %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <div class="contact-form-group">
                        <label>Email</label>
                        <input type="email" name="email" placeholder="Nhập địa chỉ email" class="contact-form-input">
                    </div>

                    <div class="contact-form-group">
                        <label>Nội dung yêu cầu dịch vụ / Tư vấn (*)</label>
                        <textarea rows="4" name="message" placeholder="Nhập nội dung bạn cần hỗ trợ..." required class="contact-form-textarea"></textarea>
                    </div>

                    <button type="submit" class="btn-submit-contact">Gửi Yêu Cầu Tư Vấn</button>
                </form>
            </div>

        </div>

    </div>
</main>

<%- include('components/footer') %>